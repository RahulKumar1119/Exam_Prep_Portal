# API Configuration
VITE_API_ENDPOINT=http://localhost:5000
VITE_API_URL=http://localhost:3001/api

# Environment
VITE_ENVIRONMENT=development
VITE_ENV=development

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true

# SEO — Google Search Console verification code (get it from
# Search Console > Settings > Verification, then paste ONLY the content
# string here or as an Amplify env variable and rebuild)
# VITE_GOOGLE_SITE_VERIFICATION=your-verification-code-here
